{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev --ignore-scripts",
  "buildCommand": "node tools/build-static.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/master.py": {
      "maxDuration": 300,
      "excludeFiles": "{assets/*.aac,assets/tn*.wav,public/**,dist/**,node_modules/**,stem-frontend/**,drogon_server/**,tests/**,tools/**,audio_lab/tests/**,.github/**,uploads/**,separated/**,audio_cache/**,*.html,*.md}"
    },
    "api/master-upload.js": { "maxDuration": 15 }
  },
  "crons": [
    { "path": "/api/master/cleanup", "schedule": "17 4 * * *" }
  ],
  "rewrites": [
    { "source": "/:page(lehra|hindustani|carnatic|notation|practice|games|account|audio)", "destination": "/:page/index.html" },
    { "source": "/:page(lehra|hindustani|carnatic|notation|practice|games|account|audio)/", "destination": "/:page/index.html" },
    { "source": "/separator", "destination": "/separator/index.html" },
    { "source": "/api/master/:op", "destination": "/api/master?op=:op" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(practice|account|audio)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/public/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/separator/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
