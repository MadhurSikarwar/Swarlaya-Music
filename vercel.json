{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"No dependencies to install for the static build\"",
  "buildCommand": "node tools/build-static.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/:page(lehra|hindustani|carnatic|notation|practice)", "destination": "/index.html" },
    { "source": "/:page(lehra|hindustani|carnatic|notation|practice)/", "destination": "/index.html" },
    { "source": "/separator", "destination": "/separator/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/separator/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
