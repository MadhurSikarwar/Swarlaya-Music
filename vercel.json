{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"No dependencies to install for the static build\"",
  "buildCommand": "node tools/build-static.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/:page(lehra|hindustani|carnatic|notation|practice|games|account)", "destination": "/:page/index.html" },
    { "source": "/:page(lehra|hindustani|carnatic|notation|practice|games|account)/", "destination": "/:page/index.html" },
    { "source": "/separator", "destination": "/separator/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(practice|account)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/public/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/separator/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
